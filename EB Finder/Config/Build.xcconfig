// Base build configuration applied to every target/config (referenced from
// project.yml → configFiles). It composes the committed version numbers and the
// public placeholder bundle id with an optional, git-ignored local override —
// so the public project carries no Apple Developer team and no real bundle id,
// and contributors can build without either.
#include "Version.xcconfig"

// Bundle id root. Everything else is derived from it: the extension is
// $(APP_BUNDLE_ID).extension and the shared app group is group.$(APP_BUNDLE_ID)
// (project.yml, both .entitlements, Extension/Info.plist). Override it locally
// or in CI via Signing.local.xcconfig — the placeholder below builds fine on the
// simulator.
APP_BUNDLE_ID = com.example.ebfinder

// Local, git-ignored overrides: DEVELOPMENT_TEAM and APP_BUNDLE_ID.
#include? "Signing.local.xcconfig"

// Host serving the partner feed (e.g. feed.example.com). Deliberately empty in
// the repo: set it in the git-ignored Feed.local.xcconfig, or via the FEED_HOST
// env var on Xcode Cloud (ci_scripts/ci_post_clone.sh writes that file).
FEED_HOST =
#include? "Feed.local.xcconfig"
