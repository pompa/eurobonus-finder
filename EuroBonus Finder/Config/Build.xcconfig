// Base build configuration applied to every target/config (referenced from
// project.yml → configFiles). It composes the public placeholders with an
// optional, git-ignored local override — so the public project carries no Apple
// Developer team, real bundle id or feed host, and contributors can build
// without them.

// Sunset build for the old TestFlight: above any version it shipped there, so it
// isn't uploaded as 0.0.0 from a branch build. A tag still overrides it via
// Build.local.xcconfig (ci_scripts/ci_post_clone.sh), as does Xcode Cloud's build number.
MARKETING_VERSION = 2026.10.13
CURRENT_PROJECT_VERSION = 1

// Bundle id root. Everything else is derived from it: the extension is
// $(APP_BUNDLE_ID).extension and the shared app group is group.$(APP_BUNDLE_ID)
// (project.yml, both .entitlements, Extension/Info.plist). The placeholder
// builds fine on the simulator.
APP_BUNDLE_ID = com.example.ebfinder

// URL scheme the app registers (App/Info.plist) and the extension links to
// (feed.js), e.g. eurobonusfinder://extension.
APP_URL_SCHEME = eurobonusfinder

// Host serving the partner feed (e.g. feed.example.com). Deliberately empty in
// the repo; the extension build fails until it's set.
FEED_HOST =

// Local, git-ignored overrides for any of the above plus DEVELOPMENT_TEAM.
// Included last so its values win. Xcode Cloud writes it from env vars
// (ci_scripts/ci_post_clone.sh).
#include? "Build.local.xcconfig"
