{
  "sourceLanguage": "en",
  "strings": {
    "sunset.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder has launched"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder har lanserats"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder er lanceret"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder er lansert"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder on julkaistu"
          }
        }
      }
    },
    "sunset.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This beta is ending. The app is now on the App Store, and new TestFlight testers are welcome."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här betan avslutas. Appen finns nu på App Store, och nya TestFlight-testare är välkomna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne beta lukker. Appen er nu i App Store, og nye TestFlight-testere er velkomne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne betaen avsluttes. Appen er nå i App Store, og nye TestFlight-testere er velkomne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä beta päättyy. Sovellus on nyt App Storessa, ja uudet TestFlight-testaajat ovat tervetulleita."
          }
        }
      }
    },
    "sunset.cta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to website"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå till webbplatsen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til hjemmesiden"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til nettstedet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry verkkosivustolle"
          }
        }
      }
    },
    "sunset.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can then delete this beta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan kan du radera den här betan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter kan du slette denne beta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter kan du slette denne betaen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen jälkeen voit poistaa tämän betan."
          }
        }
      }
    }
  },
  "version": "1.0"
}