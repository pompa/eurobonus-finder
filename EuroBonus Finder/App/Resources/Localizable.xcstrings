    "extensionSettings.permissionHint" : {
      "comment" : "Hint under the Other Websites row until it's known to be Allow. Safari can't tell Ask from Deny, so both (and not-yet-reported) show this.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt Andre websteder til Tillad i Safaris udvidelsesindstillinger. Det opdateres, næste gang du indlæser en side."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set Other Websites to Allow in Safari’s extension settings. This updates the next time you load a page."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta Muut verkkosivustot tilaan Salli Safarin laajennusasetuksissa. Tieto päivittyy, kun lataat seuraavan sivun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett Andre nettsteder til Tillat i Safaris utvidelsesinnstillinger. Det oppdateres neste gang du laster inn en side."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in Andra webbplatser på Tillåt i Safaris tilläggsinställningar. Det uppdateras nästa gång du läser in en sida."
          }
        }
      }
    },
