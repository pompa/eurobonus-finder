{
  "sourceLanguage" : "en",
  "strings" : {
    "about.disclaimer.body" : {
      "comment" : "About page — independence disclaimer body.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus Finder er ikke officielt tilknyttet SAS – Scandinavian Airlines eller EuroBonus. Tjenesten er et uafhængigt projekt og bruger SAS' offentligt tilgængelige partnerdata."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus Finder is not officially affiliated with SAS – Scandinavian Airlines or EuroBonus. It is an independent project and uses SAS's publicly available partner data."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus Finder ei ole virallisesti yhteydessä SAS – Scandinavian Airlines -yhtiöön tai EuroBonus-ohjelmaan. Palvelu on itsenäinen projekti, ja se käyttää SAS:n julkisesti saatavilla olevia kumppanitietoja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus Finder er ikke offisielt tilknyttet SAS – Scandinavian Airlines eller EuroBonus. Tjenesten er et uavhengig prosjekt og bruker SAS' offentlig tilgjengelige partnerdata."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus Finder är inte officiellt anslutet till SAS – Scandinavian Airlines eller EuroBonus. Tjänsten är ett oberoende projekt och använder SAS publikt tillgängliga partnerdata."
          }
        }
      }
    },
