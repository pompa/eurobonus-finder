{
  "sourceLanguage": "en",
  "strings": {
    "sunset.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder has launched"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder har lanserats"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder er lanceret"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder er lansert"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "EuroBonus Finder on julkaistu"
          }
        }
      }
    },
    "sunset.launched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for testing! This beta is being retired and will stop working soon. EuroBonus Finder is now available on the App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du testat! Den här betan avvecklas och slutar snart fungera. EuroBonus Finder finns nu på App Store."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak fordi du testede! Denne beta udfases og holder snart op med at virke. EuroBonus Finder er nu tilgængelig i App Store."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du testet! Denne betaen fases ut og slutter snart å virke. EuroBonus Finder er nå tilgjengelig i App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos testaamisesta! Tämä beta poistuu käytöstä ja lakkaa pian toimimasta. EuroBonus Finder on nyt saatavilla App Storesta."
          }
        }
      }
    },
    "sunset.testflight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to keep testing new features? New TestFlight testers are welcome. You'll find the link on eurobonus.pompa.se."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du fortsätta testa nya funktioner? Nya TestFlight-testare är välkomna. Länken finns på eurobonus.pompa.se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du blive ved med at teste nye funktioner? Nye TestFlight-testere er velkomne. Du finder linket på eurobonus.pompa.se."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fortsette å teste nye funksjoner? Nye TestFlight-testere er velkomne. Du finner lenken på eurobonus.pompa.se."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko jatkaa uusien ominaisuuksien testaamista? Uudet TestFlight-testaajat ovat tervetulleita. Linkki löytyy osoitteesta eurobonus.pompa.se."
          }
        }
      }
    },
    "sunset.cta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to eurobonus.pompa.se"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå till eurobonus.pompa.se"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til eurobonus.pompa.se"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til eurobonus.pompa.se"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry osoitteeseen eurobonus.pompa.se"
          }
        }
      }
    },
    "sunset.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete this app once you've installed the new one."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan radera den här appen när du har installerat den nya."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan slette denne app, når du har installeret den nye."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan slette denne appen når du har installert den nye."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit poistaa tämän sovelluksen, kun olet asentanut uuden."
          }
        }
      }
    }
  },
  "version": "1.0"
}