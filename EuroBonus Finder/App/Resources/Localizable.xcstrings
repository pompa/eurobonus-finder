    "extension.settingsPath" : {
      "comment" : "Shown while iOS rate-limits opening Safari's extension settings. Keep the bold Markdown link **[..](settings:)** — it opens Settings › Apps.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lader kun apps åbne Safari-indstillingerne to gange i minuttet. **[Åbn Indstillinger › Apps](settings:)**, og gå derefter til Safari › Udvidelser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS only lets apps open Safari settings twice a minute. **[Open Settings › Apps](settings:)**, then go to Safari › Extensions."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS sallii appien avata Safarin asetukset vain kahdesti minuutissa. **[Avaa Asetukset › Apit](settings:)** ja siirry sitten kohtaan Safari › Laajennukset."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lar bare apper åpne Safari-innstillingene to ganger i minuttet. **[Åpne Innstillinger › Apper](settings:)**, og gå deretter til Safari › Utvidelser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS låter bara appar öppna Safari-inställningarna två gånger i minuten. **[Öppna Inställningar › Appar](settings:)** och gå sedan till Safari › Tillägg."
          }
        }
      }
    },
    "extensionSettings.extensionHint" : {
      "comment" : "Hint under the Safari Extension row while the extension is off or its state is unknown.",
