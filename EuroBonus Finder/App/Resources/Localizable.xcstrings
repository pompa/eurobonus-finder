    "onboarding.region.detail" : {
      "comment" : "Body on the 'choose your region' onboarding step. The region picks which country's EuroBonus partners are shown.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus-partnere og point varierer fra land til land. Vælg det land, hvor du handler — du kan ændre det senere i indstillingerne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus partners and points differ by country. Pick the country where you shop — you can change it later in Settings."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus-kumppanit ja pisteet vaihtelevat maittain. Valitse maa, jossa teet ostoksesi — voit vaihtaa sen myöhemmin asetuksista."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus-partnere og poeng varierer fra land til land. Velg landet der du handler — du kan endre det senere i innstillingene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EuroBonus-partners och poäng skiljer sig mellan länder. Välj landet där du handlar — du kan ändra det senare i inställningarna."
          }
        }
      }
    },
